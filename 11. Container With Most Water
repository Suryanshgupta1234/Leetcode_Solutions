class Solution {
    public int maxArea(int[] height) {
        int maxWater = 0;
       int lp = 0;
       int rp = height.length-1;
       while(lp < rp){
        int h = Math.min(height[lp], height[rp]);
        int width = rp-lp;
        int contains = h * width;
        maxWater = Math.max(maxWater, contains);

        if(height[lp] < height[rp]){
            lp++;
        }
        else{
            rp--;
        }
       } 
       return maxWater;
    }
}
