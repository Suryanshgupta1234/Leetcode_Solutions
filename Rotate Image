class Solution {
    public void rotate(int[][] matrix) {
        List<List<Integer>> rotate = new ArrayList<>();
        int n = matrix.length;

        int col = 0;
        while (col < n) {

            List<Integer> list = new ArrayList<>();

            for (int row = n - 1; row >= 0; row--) {
                list.add(matrix[row][col]);
            }

            rotate.add(list);
            col++;
        }
         for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                matrix[i][j] = rotate.get(i).get(j);
            }
        }
    }
}
