class Solution {
    public void setZeroes(int[][] matrix) {
       int n = matrix.length, m = matrix[0].length;
       boolean zerorow[] = new boolean[n];
       boolean zerocol[] = new boolean[m];

        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(matrix[i][j] == 0){
                    zerorow[i] = true;
                    zerocol[j] = true;
                }
            }
        } 
        for(int i=0; i<n; i++){
            for(int j=0; j<m; j++){
                if(zerorow[i] || zerocol[j]){
                    matrix[i][j] = 0;
                }
            }
        }
    }
}
