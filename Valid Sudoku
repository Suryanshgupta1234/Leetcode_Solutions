class Solution {
    public boolean isValidSudoku(char[][] board) {
        for(int i=0; i<9; i++){
            Set<Character> row = new HashSet<>();
            Set<Character> col = new HashSet<>();
            Set<Character> subgrid = new HashSet<>();
            for(int j=0; j<9; j++){
                char r = board[i][j];
                if(r != '.'){
                    if(row.contains(r))return false;
                    row.add(r);
                }
                char c = board[j][i];
                if(c != '.'){
                    if(col.contains(c))return false;
                    col.add(c);
                }
                int startRow = (i/3)*3;
                int startCol = (i%3)*3;
                char sub = board[startRow + j/3][startCol + j%3];
                if(sub != '.'){
                    if(subgrid.contains(sub))return false;
                    subgrid.add(sub);
                }
            }
        }
        return true;
    }
}
